# Chai VC Platform - Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/chai_vc?schema=public

# NPPES API Configuration
NPPES_KEY=your_nppes_api_key_here
NPPES_API_BASE_URL=https://npiregistry.cms.hhs.gov/api/
NPPES_API_VERSION=v2.1

# ACA-Py Agent Configuration
ACA_PY_URL=http://localhost:3001
ACA_PY_API_KEY=your_aca_py_api_key_here

# OIDC / OAuth Configuration (for LinkedIn, etc.)
OIDC_CLIENT_ID=your_oidc_client_id_here
OIDC_CLIENT_SECRET=your_oidc_client_secret_here
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: External Services
# PROMETHEUS_ENABLED=true
# GRAFANA_URL=http://localhost:3000/grafana
