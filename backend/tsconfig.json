{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "prisma/seed.ts",
    "prisma/**/*",
    "src/types/**/*.d.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "__tests__"
  ]
}
