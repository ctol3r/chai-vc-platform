{
  "compilerOptions": {
    "skipLibCheck": true,
    "moduleResolution": "node",
    "target": "ES2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "types": ["node", "jest"],
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["__tests__"]
}
