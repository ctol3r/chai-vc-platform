{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["__tests__", "src/blockchain/**/*", "src/graphql/**/*", "src/controllers/**/*", "src/credential_registry/**/*", "src/did/**/*", "src/didcomm/**/*", "src/licensing/**/*", "src/middleware/**/*", "src/nppes_cache.py", "src/payments/**/*", "src/privileges/**/*", "src/provisional_attestation.ts", "src/queues/**/*", "src/utils/**/*", "src/app.ts", "src/index.ts"]
}
