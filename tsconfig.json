{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "rootDir": "./backend/src",
    "outDir": "./backend/dist",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "baseUrl": "./backend/src",
    "paths": {
      "packages/*": ["packages/*"],
      "controllers/*": ["controllers/*"]
    }
  },
  "include": ["backend/src/**/*.ts"],
  "exclude": ["backend/prisma/**/*.ts"]
}
