# VitalCV Backend Environment Configuration
# Copy this file to .env and update values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://vitalcv:vitalcv_dev_pass@localhost:5432/vitalcv_dev

# ============================================
# REDIS CACHE & QUEUE
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# ACA-PY (ARIES CLOUD AGENT)
# ============================================
# Use stub for local development
ACAPY_STUB=true
ACAPY_URL=http://localhost:8031
ACAPY_API_KEY=dev-api-key
ACAPY_USE_TLS=false
ACAPY_REJECT_UNAUTHORIZED=false

# Production values (comment out for dev)
# ACAPY_STUB=false
# ACAPY_URL=https://acapy.vitalcv.com
# ACAPY_API_KEY=<production-api-key>
# ACAPY_USE_TLS=true
# ACAPY_REJECT_UNAUTHORIZED=true

# ============================================
# SD-JWT SIGNING
# ============================================
SD_JWT_SIGNING_KEY=dev-secret-key-change-in-production

# Production: Use strong secret
# SD_JWT_SIGNING_KEY=<generate-with: openssl rand -base64 32>

# ============================================
# FILE UPLOADS
# ============================================
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Production: Use S3
# UPLOAD_BUCKET=s3://vitalcv-uploads
# AWS_REGION=us-east-1

# ============================================
# API CONFIGURATION
# ============================================
BACKEND_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Production
# BACKEND_BASE_URL=https://api.vitalcv.com
# NODE_ENV=production

# ============================================
# NPPES (NPI LOOKUP)
# ============================================
# Optional: Use proxy for rate limiting
# NPPES_PROXY_URL=http://internal-proxy:8080
NPPES_CACHE_TTL=86400  # 24 hours in seconds

# ============================================
# SMTP (EMAIL)
# ============================================
# Dev: Use MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@vitalcv.com

# Production: Use real SMTP
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=apikey
# SMTP_PASSWORD=<sendgrid-api-key>

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
# Prometheus scrape enabled by default
METRICS_ENABLED=true

# Sentry (error tracking)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development

# ============================================
# AUTHENTICATION (FUTURE)
# ============================================
# JWT_SECRET=<generate-strong-secret>
# JWT_EXPIRY=86400  # 24 hours
# SESSION_SECRET=<generate-strong-secret>

# OAuth2 (LinkedIn, etc.)
# LINKEDIN_CLIENT_ID=<client-id>
# LINKEDIN_CLIENT_SECRET=<client-secret>
# LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_BBS_SIGNATURES=false
ENABLE_PUBMED_INTEGRATION=false
ENABLE_DOXIMITY_INTEGRATION=false

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000  # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3001

# Production: Add partner domains
# CORS_ORIGINS=https://vitalcv.com,https://api.vitalcv.com,https://partner1.com

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json or simple

# ============================================
# QUEUE SETTINGS
# ============================================
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=2000  # milliseconds

# ============================================
# SECURITY
# ============================================
# Helmet security headers
HELMET_ENABLED=true

# Content Security Policy
CSP_ENABLED=false  # Enable in production

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Enable detailed error messages
DEBUG=false

# Skip certain validations
SKIP_EMAIL_VERIFICATION=true
SKIP_NPI_VALIDATION=false

# Demo mode (seeded data)
DEMO_MODE=true
