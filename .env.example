# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chai_vc_dev
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chai_vc_dev

# Backend API Configuration
API_PORT=4000
NODE_ENV=development
JWT_SECRET=your-secret-key-here
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Blockchain Configuration
POLKADOT_WS_ENDPOINT=ws://localhost:9944
ETHEREUM_RPC_URL=http://localhost:8545
ETHEREUM_PRIVATE_KEY=your-private-key-here

# ACA-Py Agent Configuration
ACAPY_ADMIN_URL=http://localhost:8021
ACAPY_WEBHOOK_URL=http://localhost:8022
ACAPY_API_KEY=your-acapy-api-key

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# External Services
OCEAN_NETWORK=development
OCEAN_NODE_URI=http://localhost:8030

# Monitoring & Logging
LOG_LEVEL=debug
PROMETHEUS_PORT=9090

# Security
ENCRYPTION_KEY=your-32-byte-encryption-key-here
HARDWARE_WALLET_REQUIRED=false

# Testing
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/chai_vc_test

# Optional: Development Features
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_DEBUG_LOGGING=true
MOCK_BLOCKCHAIN_CALLS=false